# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/doctor_tracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/doctor_tracker
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker

# ── Auth ────────────────────────────────────────────────
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
# Short-lived JWT sent with every request
ACCESS_TOKEN_TTL=15m
# Long-lived, rotated on every use, stored hashed in MongoDB
REFRESH_TOKEN_TTL=7d
ACCESS_COOKIE_NAME=dt_access
REFRESH_COOKIE_NAME=dt_refresh

# ── CORS ────────────────────────────────────────────────
# Frontend origin(s), comma separated
CLIENT_URL=http://localhost:3000

# ── Seed admin (used by `npm run seed`) ─────────────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@doctortracker.com
ADMIN_PASSWORD=Admin@12345
