                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Admin only. role: `admin` | `staff` (staff cannot delete). Password needs 8+ chars, upper, lower and a number."
          }
        }
      ]
    },
